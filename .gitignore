# === Python ===
__pycache__/
*.pyc
*.pyo
.pytest_cache/
# Updater-managed venv bootstrap target (PEP 668 fallback)
.venv/
# Updater requirements.txt install marker (sha256 of last successful install)
.mav_requirements_hash
# Developer opt-out — touch .mav_dev at repo root to disable the self-updater
.mav_dev

# === Node (dependency state only — dist/ is committed) ===
node_modules/
mav_gss_lib/web/node_modules/

# === Logs & Runtime Outputs ===
/logs/
/images/
tests/test_images/
tests/images/
# Machine-local beacon log fixtures for Task 9a regression tests
tests/fixtures/beacon_samples/
# Machine-local golden IQ binaries for tests/test_golden_iq_replay.py.
# The .json manifests (expected frames, provenance, sha256) ARE tracked —
# a clone missing only the binaries skips the goldens loudly, not silently.
tests/fixtures/iq/*
!tests/fixtures/iq/*.json
backup_control/logs/
generated_commands/
.pending_queue.jsonl
# GNC register-snapshot sidecar (persisted latest-value-per-register cache)
.gnc_snapshot.json

# === Mission-Sensitive (NEVER track) ===
# Command schema contains mission command definitions — security sensitive
mav_gss_lib/missions/maveric/commands.yml
mav_gss_lib/missions/maveric/mission.yml
mav_gss_lib/missions/maveric/mission.yml.bak.*

# === Operator-Local Config ===
# Main station config — operator ZMQ addresses, local paths
mav_gss_lib/gss.yml
# Per-mission station config — same as above, fetched TLEs/tuned LO offsets
# are instance-specific. gss.example.yml is the tracked template, not ignored.
mav_gss_lib/gss.*.yml
!mav_gss_lib/gss.example.yml
