options:
  parameters:
    author: Irfan Annuar - USC ISI SERC
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: USC ISI SERC
    description: MAVERIC CubeSat ASM+Golay Uplink (AX100 Mode 5) + Full Duplex RX
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: MAV_DUO
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: MAVERIC DUAL FRAME
    window_size: (1280,1024)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 276.0]
    rotation: 0
    state: enabled

blocks:
- name: decoder_options
  id: variable
  parameters:
    comment: "gr-satellites options matched to the database: --syncword_threshold\nonly parses when an AX100/FX.25 deframer is in the file (a pure AX.25\ndatabase would abort argparse). Mirrors _decoder_options() in MAV_DUO.py."
    value: ('--syncword_threshold 6' * any(l.split('#')[0].strip().startswith('framing:')
      and ('AX100' in l.split('#')[0] or 'FX.25' in l.split('#')[0]) for l in (open(decoder_yml).read()
      if __import__('os').path.isfile(decoder_yml) else '').splitlines()))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 412.0]
    rotation: 0
    state: enabled
- name: decoder_yml
  id: variable
  parameters:
    comment: "Per-mission decoder database: GSS_DECODER_YML override, otherwise\nthe exact decoders/<MISSION>_DECODER.yml beside this flowgraph. Missing profiles\nfail closed; there is no cross-mission MAVERIC fallback. Mirrors _decoder_yml()."
    value: ((__import__('os').environ.get('GSS_DECODER_YML') or '').strip() or __import__('os').path.join(__import__('os').path.dirname(__import__('os').path.abspath(__import__('sys').argv[0])),
      'decoders', ((__import__('os').environ.get('GSS_MISSION') or 'maveric').strip().upper() + '_DECODER.yml')))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 348.0]
    rotation: 0
    state: enabled
- name: rx_decim
  id: variable
  parameters:
    comment: RX decimation 1Msps -> 200ksps for satellite_decoder + displays
    value: '5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [248, 408.0]
    rotation: 0
    state: enabled
- name: rx_lo_offset
  id: variable
  parameters:
    comment: "RX LO parks this far above rx_freq; doppler rides the DSP NCO.\nSingle-sourced from tracking.control.rx_lo_offset_hz via the GSS_RX_LO_OFFSET_HZ\nenv var RadioService injects; the literal is the standalone-launch fallback."
    value: float(__import__('os').environ.get('GSS_RX_LO_OFFSET_HZ', 250e3))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [472, 272.0]
    rotation: 0
    state: enabled
- name: tx_lo_offset
  id: variable
  parameters:
    comment: "TX LO parks this far below tx_freq; keeps TX LO leak + LO-vs-LO\nbeat products out of the RX passband. Single-sourced from tracking.control.tx_lo_offset_hz\nvia GSS_TX_LO_OFFSET_HZ; the literal is the standalone-launch fallback."
    value: float(__import__('os').environ.get('GSS_TX_LO_OFFSET_HZ', -400e3))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [472, 328.0]
    rotation: 0
    state: enabled
- name: baud
  id: variable
  parameters:
    comment: ''
    value: '9600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 408.0]
    rotation: 0
    state: enabled
- name: rx_freq
  id: variable
  parameters:
    comment: "RX center frequency. Seeded from the GSS_RX_FREQ_HZ env var RadioService\ninjects (config rx.frequency / tracking.frequencies.rx_hz); the literal is the\nstandalone-launch fallback. Doppler retunes live via 52003."
    value: float(__import__('os').environ.get('GSS_RX_FREQ_HZ', 437.575e6))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 408.0]
    rotation: 0
    state: enabled
- name: tx_freq
  id: variable
  parameters:
    comment: "TX center frequency. Seeded from the GSS_TX_FREQ_HZ env var RadioService\ninjects (config tx.frequency / tracking.frequencies.tx_hz); the literal is the\nstandalone-launch fallback. Doppler retunes live via 52004."
    value: float(__import__('os').environ.get('GSS_TX_FREQ_HZ', 437.575e6))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 408.0]
    rotation: 0
    state: enabled
- name: modindex
  id: variable
  parameters:
    comment: "AX100 auto default: the flight param list shows modindex 0.0 =\nAUTOMATIC, and the manual's auto table picks h = 1/1.5 for 1300-60000\nbaud. This exact value was hardware-verified against the flight unit\nin the Mode 5 uplink bench tests. ROADS 2's measured h=0.5 is that\nbird's own config, not the AX100 default."
    value: 1/1.5
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 408.0]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: SDR RF TX burst gain (applied by the PTT gate during TX; hardware idles at 0 dB)
    gui_hint: 0,1,1,1
    label: TX Gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '89'
    value: '50'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 316.0]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: "SDR RF RX gain (B210 max 76 dB). Boot value from GSS_RX_GAIN\n(platform.radio.rx_gain,
      injected by RadioService); the slider\nstill overrides live."
    gui_hint: 4,0,1,2
    label: RX Gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '76'
    value: float(__import__('os').environ.get('GSS_RX_GAIN', 40))
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 444.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: RX sample rate (independent of TX)
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 272.0]
    rotation: 0
    state: enabled
